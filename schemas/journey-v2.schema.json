{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jmitchel3/crawlson/schemas/journey-v2.schema.json",
  "title": "Crawlson read-only journey v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "journey", "target", "evidence", "steps"],
  "properties": {
    "schema_version": { "const": 2 },
    "journey": { "$ref": "#/$defs/journey" },
    "target": { "$ref": "#/$defs/target" },
    "authentication": { "$ref": "#/$defs/authentication" },
    "evidence": { "$ref": "#/$defs/evidence" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "allOf": [
        {
          "contains": { "$ref": "#/$defs/checkpoint_step" },
          "minContains": 1
        },
        {
          "contains": { "$ref": "#/$defs/capture_step" },
          "minContains": 1
        }
      ],
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "$defs": {
    "step": {
      "oneOf": [
        { "$ref": "#/$defs/non_capture_step" },
        { "$ref": "#/$defs/capture_step" }
      ]
    },
    "non_capture_step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "action"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9._-]{1,96}$" },
        "title": { "type": "string", "minLength": 1 },
        "guide_instruction": { "type": "string", "minLength": 1, "maxLength": 16384 },
        "action": {
          "oneOf": [
            { "$ref": "#/$defs/navigate" },
            { "$ref": "#/$defs/check_url" },
            { "$ref": "#/$defs/check_text" }
          ]
        }
      }
    },
    "capture_step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "action"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9._-]{1,96}$" },
        "title": { "type": "string", "minLength": 1 },
        "guide_instruction": { "type": "string", "minLength": 1, "maxLength": 16384 },
        "evidence_for": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9._-]{1,96}$" }
        },
        "action": { "$ref": "#/$defs/capture" }
      }
    },
    "checkpoint_step": {
      "type": "object",
      "properties": {
        "action": {
          "oneOf": [
            { "$ref": "#/$defs/check_url" },
            { "$ref": "#/$defs/check_text" }
          ]
        }
      },
      "required": ["action"]
    },
    "navigate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "path"],
      "properties": {
        "type": { "const": "navigate" },
        "path": { "type": "string", "pattern": "^/(?!/)[^?#]*$" }
      }
    },
    "check_url": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "path"],
      "properties": {
        "type": { "const": "check_url" },
        "path": { "type": "string", "pattern": "^/(?!/)[^?#]*$" }
      }
    },
    "journey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision", "title", "purpose", "expected_outcome", "mode"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9._-]{1,96}$" },
        "revision": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 },
        "expected_outcome": { "type": "string", "minLength": 1 },
        "mode": { "const": "read_only" }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin"],
      "properties": {
        "origin": { "type": "string", "format": "uri" }
      }
    },
    "authentication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "role"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trace", "diagnostics"],
      "properties": {
        "trace": { "const": true },
        "diagnostics": { "const": true }
      }
    },
    "check_text": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "selector", "expected"],
      "properties": {
        "type": { "const": "check_text" },
        "selector": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "expected": { "type": "string", "minLength": 1, "maxLength": 65536 },
        "comparison": { "enum": ["exact", "contains"] }
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "selector", "alt_text"],
      "properties": {
        "type": { "const": "capture" },
        "selector": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "alt_text": { "type": "string", "minLength": 1, "maxLength": 4096 }
      }
    }
  }
}
