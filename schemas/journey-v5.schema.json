{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jmitchel3/crawlson/schemas/journey-v5.schema.json",
  "title": "Crawlson disposable mutating journey v5",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "journey", "target", "authentication", "fixture", "evidence", "setup_steps", "steps", "cleanup_steps"],
  "properties": {
    "schema_version": { "const": 5 },
    "journey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision", "title", "purpose", "expected_outcome", "mode"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "revision": { "type": "integer", "minimum": 1 },
        "title": { "$ref": "#/$defs/nonempty" },
        "purpose": { "$ref": "#/$defs/nonempty" },
        "expected_outcome": { "$ref": "#/$defs/nonempty" },
        "mode": { "const": "mutating" }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin"],
      "properties": { "origin": { "type": "string", "format": "uri" } }
    },
    "authentication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "role", "verification_step", "disposable_actor"],
      "properties": {
        "provider": { "$ref": "#/$defs/id" },
        "role": { "$ref": "#/$defs/id" },
        "verification_step": { "$ref": "#/$defs/id" },
        "disposable_actor": { "const": true }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "maximum_lifetime_seconds"],
      "properties": {
        "kind": { "const": "self_expiring_ui" },
        "maximum_lifetime_seconds": { "type": "integer", "minimum": 1, "maximum": 3600 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trace", "diagnostics"],
      "properties": {
        "trace": { "const": true },
        "diagnostics": { "const": true }
      }
    },
    "setup_steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "contains": { "$ref": "#/$defs/check_absent_step" },
      "items": { "$ref": "#/$defs/support_step" }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "contains": { "$ref": "#/$defs/main_mutation_step" },
      "items": { "$ref": "#/$defs/main_step" }
    },
    "cleanup_steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "contains": { "$ref": "#/$defs/ensure_absent_step" },
      "items": { "$ref": "#/$defs/cleanup_step" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9._-]{1,96}$" },
    "nonempty": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "selector": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "\\S" },
    "id_selector": { "type": "string", "pattern": "^#[A-Za-z0-9_.-]{1,96}$" },
    "path": { "type": "string", "pattern": "^/(?!/)[^?#\\\\]*$" },
    "effect": { "enum": ["read_only", "mutating"] },
    "base_step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "effect", "action"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/nonempty" },
        "effect": { "$ref": "#/$defs/effect" },
        "action": { "$ref": "#/$defs/read_action" }
      }
    },
    "support_step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "effect", "action"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/nonempty" },
        "effect": { "const": "read_only" },
        "action": { "$ref": "#/$defs/read_action" }
      }
    },
    "main_step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "effect", "action"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/nonempty" },
        "guide_instruction": { "type": "string", "minLength": 1, "maxLength": 16384, "pattern": "\\S" },
        "evidence_for": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "effect": { "$ref": "#/$defs/effect" },
        "action": { "oneOf": [{ "$ref": "#/$defs/read_action" }, { "$ref": "#/$defs/fill_text" }, { "$ref": "#/$defs/click_button" }] }
      }
    },
    "cleanup_step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "effect", "action"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/nonempty" },
        "effect": { "$ref": "#/$defs/effect" },
        "action": { "oneOf": [{ "$ref": "#/$defs/read_action" }, { "$ref": "#/$defs/ensure_absent" }] }
      }
    },
    "main_mutation_step": {
      "type": "object",
      "required": ["effect", "action"],
      "properties": {
        "effect": { "const": "mutating" },
        "action": { "oneOf": [{ "$ref": "#/$defs/fill_text" }, { "$ref": "#/$defs/click_button" }] }
      }
    },
    "check_absent_step": {
      "type": "object",
      "required": ["action"],
      "properties": { "action": { "$ref": "#/$defs/check_absent" } }
    },
    "ensure_absent_step": {
      "type": "object",
      "required": ["effect", "action"],
      "properties": {
        "effect": { "const": "mutating" },
        "action": { "$ref": "#/$defs/ensure_absent" }
      }
    },
    "read_action": {
      "oneOf": [
        { "$ref": "#/$defs/navigate" },
        { "$ref": "#/$defs/check_url" },
        { "$ref": "#/$defs/check_text" },
        { "$ref": "#/$defs/capture" },
        { "$ref": "#/$defs/follow_link" },
        { "$ref": "#/$defs/check_absent" }
      ]
    },
    "navigate": {
      "type": "object", "additionalProperties": false, "required": ["type", "path"],
      "properties": { "type": { "const": "navigate" }, "path": { "$ref": "#/$defs/path" } }
    },
    "check_url": {
      "type": "object", "additionalProperties": false, "required": ["type", "path"],
      "properties": { "type": { "const": "check_url" }, "path": { "$ref": "#/$defs/path" } }
    },
    "check_text": {
      "type": "object", "additionalProperties": false, "required": ["type", "selector", "expected"],
      "properties": {
        "type": { "const": "check_text" }, "selector": { "$ref": "#/$defs/selector" },
        "expected": { "type": "string", "minLength": 1, "maxLength": 65536 },
        "comparison": { "enum": ["exact", "contains"] }
      }
    },
    "capture": {
      "type": "object", "additionalProperties": false, "required": ["type", "selector", "alt_text"],
      "properties": {
        "type": { "const": "capture" }, "selector": { "$ref": "#/$defs/selector" },
        "alt_text": { "type": "string", "minLength": 1, "maxLength": 4096 }
      }
    },
    "follow_link": {
      "type": "object", "additionalProperties": false, "required": ["type", "selector", "expected_path", "alt_text"],
      "properties": {
        "type": { "const": "follow_link" }, "selector": { "$ref": "#/$defs/selector" },
        "expected_path": { "$ref": "#/$defs/path" },
        "alt_text": { "type": "string", "minLength": 1, "maxLength": 4096 }
      }
    },
    "check_absent": {
      "type": "object", "additionalProperties": false, "required": ["type", "selector", "expected_text"],
      "properties": {
        "type": { "const": "check_absent" }, "selector": { "$ref": "#/$defs/selector" },
        "expected_text": { "type": "string", "minLength": 1, "maxLength": 65536 }
      }
    },
    "fill_text": {
      "type": "object", "additionalProperties": false, "required": ["type", "selector", "value", "alt_text"],
      "properties": {
        "type": { "const": "fill_text" }, "selector": { "$ref": "#/$defs/id_selector" },
        "value": { "const": "$fixture_token" },
        "alt_text": { "type": "string", "minLength": 1, "maxLength": 4096 }
      }
    },
    "click_button": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "selector", "form_selector", "action_path", "expected_path", "verify_selector", "expected_text", "alt_text"],
      "properties": {
        "type": { "const": "click_button" }, "selector": { "$ref": "#/$defs/id_selector" },
        "form_selector": { "$ref": "#/$defs/id_selector" }, "action_path": { "$ref": "#/$defs/path" },
        "expected_path": { "$ref": "#/$defs/path" }, "verify_selector": { "$ref": "#/$defs/selector" },
        "expected_text": { "type": "string", "minLength": 1, "maxLength": 65536 },
        "alt_text": { "type": "string", "minLength": 1, "maxLength": 4096 }
      }
    },
    "ensure_absent": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "status_selector", "expected_text", "button_selector", "form_selector", "action_path", "expected_path", "alt_text"],
      "properties": {
        "type": { "const": "ensure_absent" }, "status_selector": { "$ref": "#/$defs/selector" },
        "expected_text": { "type": "string", "minLength": 1, "maxLength": 65536 },
        "button_selector": { "$ref": "#/$defs/id_selector" }, "form_selector": { "$ref": "#/$defs/id_selector" },
        "action_path": { "$ref": "#/$defs/path" }, "expected_path": { "$ref": "#/$defs/path" },
        "alt_text": { "type": "string", "minLength": 1, "maxLength": 4096 }
      }
    }
  }
}
